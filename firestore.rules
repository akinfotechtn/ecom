rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper function (Case-insensitive email check)
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'akinfotechtn@gmail.com' || 
         request.auth.token.email.lower() == 'admin@akinfotechcctv.in');
    }

    // 1. PRODUCTS COLLECTION
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 2. BRANDS COLLECTION
    match /brands/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. CATEGORIES COLLECTION
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. HERO BANNERS & SLIDER COLLECTION
    match /hero_banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. STORE SETTINGS COLLECTION
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. CUSTOMER ORDERS COLLECTION
    match /orders/{document=**} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // 7. USER PROFILES & SAVED DELIVERY ADDRESSES
    match /users/{userId=**} {
      allow read, write: if true;
    }
  }
}
